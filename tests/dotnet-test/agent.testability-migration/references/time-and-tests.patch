+using System;
+using FullPipeline.Services;
+using Xunit;
+
+namespace FullPipeline.Tests;
+
+// A controllable TimeProvider so the time-dependent behavior is deterministic.
+internal sealed class MutableTimeProvider : TimeProvider
+{
+    private DateTimeOffset _now;
+
+    public MutableTimeProvider(DateTimeOffset start) => _now = start;
+
+    public override DateTimeOffset GetUtcNow() => _now;
+
+    public void Advance(TimeSpan delta) => _now = _now.Add(delta);
+}
+
+public class SubscriptionManagerTests
+{
+    private static readonly DateTimeOffset Start =
+        new(2025, 1, 1, 0, 0, 0, TimeSpan.Zero);
+
+    [Fact]
+    public void CreateTrial_SetsStartedAtAndFourteenDayExpiry()
+    {
+        var time = new MutableTimeProvider(Start);
+        var manager = new SubscriptionManager(time);
+
+        var sub = manager.CreateTrial("user-1");
+
+        Assert.Equal(Start.UtcDateTime, sub.StartedAt);
+        Assert.Equal(Start.UtcDateTime.AddDays(14), sub.ExpiresAt);
+        Assert.Equal("trial", sub.Plan);
+    }
+
+    [Fact]
+    public void IsActive_TrueBeforeExpiry()
+    {
+        var time = new MutableTimeProvider(Start);
+        var manager = new SubscriptionManager(time);
+        var sub = manager.CreateTrial("user-1");
+
+        time.Advance(TimeSpan.FromDays(13));
+
+        Assert.True(manager.IsActive(sub));
+    }
+
+    [Fact]
+    public void IsActive_FalseAtExpiredBoundary()
+    {
+        var time = new MutableTimeProvider(Start);
+        var manager = new SubscriptionManager(time);
+        var sub = manager.CreateTrial("user-1");
+
+        // Advance to exactly the 14-day boundary: the trial is expired, not active.
+        time.Advance(TimeSpan.FromDays(14));
+
+        Assert.False(manager.IsActive(sub));
+    }
+}
