+using Commerce.Domain;
+using Commerce.Pricing;
+using Xunit;
+
+namespace Commerce.Pricing.Tests;
+
+public sealed class PriceCalculatorTests
+{
+    [Fact]
+    public void ApplyPercentageDiscount_TenPercent_ReturnsNinety()
+    {
+        var result = new PriceCalculator().ApplyPercentageDiscount(new Money(100.00m), 10m);
+
+        Assert.Equal(90.00m, result.Amount);
+    }
+
+    [Fact]
+    public void ApplyPercentageDiscount_NegativePercentage_Throws()
+    {
+        Assert.Throws<ArgumentOutOfRangeException>(
+            () => new PriceCalculator().ApplyPercentageDiscount(new Money(100.00m), -1m));
+    }
+}
