+using FizzWare.NBuilder;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using Moq;
+using Contoso.Discounts;
+
+namespace Contoso.Discounts.Tests
+{
+    [TestClass]
+    public class DiscountServiceBoundaryTests : FixtureBase<DiscountService>
+    {
+        private Mock<IProductRepository> _repository;
+
+        protected override DiscountService CreateSut()
+        {
+            _repository = new Mock<IProductRepository>();
+            return new DiscountService(_repository.Object);
+        }
+
+        [TestMethod]
+        public void Apply_HundredPercent_ReturnsZero()
+        {
+            Product product = Builder<Product>.CreateNew()
+                .With(x => x.Id = 7)
+                .With(x => x.Price = 80m)
+                .Build();
+            _repository.Setup(x => x.Get(7)).Returns(product);
+
+            decimal result = Sut.Apply(7, 100m);
+
+            Assert.AreEqual(0m, result);
+        }
+
+        [TestMethod]
+        public void Apply_QuarterOff_ReturnsExactDiscountedValue()
+        {
+            Product product = Builder<Product>.CreateNew()
+                .With(x => x.Id = 9)
+                .With(x => x.Price = 200m)
+                .Build();
+            _repository.Setup(x => x.Get(9)).Returns(product);
+
+            decimal result = Sut.Apply(9, 25m);
+
+            Assert.AreEqual(150m, result);
+        }
+
+        [TestMethod]
+        public void Apply_NegativePercentage_Throws()
+        {
+            Assert.ThrowsException<System.ArgumentOutOfRangeException>(() => Sut.Apply(1, -1m));
+        }
+
+        [TestMethod]
+        public void Apply_PercentageAboveHundred_Throws()
+        {
+            Assert.ThrowsException<System.ArgumentOutOfRangeException>(() => Sut.Apply(1, 101m));
+        }
+
+        [TestMethod]
+        public void Apply_MissingProduct_Throws()
+        {
+            _repository.Setup(x => x.Get(404)).Returns((Product)null);
+
+            Assert.ThrowsException<System.InvalidOperationException>(() => Sut.Apply(404, 10m));
+        }
+    }
+}
