+using System;
+using Microsoft.VisualStudio.TestTools.UnitTesting;
+using Contoso.Discounts;
+
+namespace Contoso.Discounts.Tests
+{
+    [TestClass]
+    public class TieredDiscountPolicyTests
+    {
+        [TestMethod]
+        public void Constructor_NonPositiveThreshold_Throws()
+        {
+            Assert.ThrowsException<ArgumentOutOfRangeException>(() => new TieredDiscountPolicy(0m, 0.1m));
+            Assert.ThrowsException<ArgumentOutOfRangeException>(() => new TieredDiscountPolicy(-5m, 0.1m));
+        }
+
+        [TestMethod]
+        public void Constructor_RateOutOfRange_Throws()
+        {
+            Assert.ThrowsException<ArgumentOutOfRangeException>(() => new TieredDiscountPolicy(100m, -0.1m));
+            Assert.ThrowsException<ArgumentOutOfRangeException>(() => new TieredDiscountPolicy(100m, 1.1m));
+        }
+
+        [TestMethod]
+        public void Apply_NegativeSubtotal_Throws()
+        {
+            var policy = new TieredDiscountPolicy(100m, 0.1m);
+
+            Assert.ThrowsException<ArgumentOutOfRangeException>(() => policy.Apply(-1m));
+        }
+
+        [TestMethod]
+        public void Apply_BelowThreshold_ReturnsSubtotalUnchanged()
+        {
+            var policy = new TieredDiscountPolicy(100m, 0.1m);
+
+            decimal result = policy.Apply(50m);
+
+            Assert.AreEqual(50m, result);
+        }
+
+        [TestMethod]
+        public void Apply_ExactThreshold_AppliesDiscount()
+        {
+            var policy = new TieredDiscountPolicy(100m, 0.1m);
+
+            decimal result = policy.Apply(100m);
+
+            Assert.AreEqual(90m, result);
+        }
+
+        [TestMethod]
+        public void Apply_AboveThreshold_ReturnsExactDiscountedValue()
+        {
+            var policy = new TieredDiscountPolicy(100m, 0.1m);
+
+            decimal result = policy.Apply(200m);
+
+            Assert.AreEqual(180m, result);
+        }
+    }
+}
