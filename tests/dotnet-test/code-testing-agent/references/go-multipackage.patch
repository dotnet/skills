+package shipping
+
+import "testing"
+
+func TestRate(t *testing.T) {
+	brackets := []Bracket{
+		{UpToGrams: 100, Cents: 500},
+		{UpToGrams: 500, Cents: 900},
+	}
+
+	tests := []struct {
+		name     string
+		weight   int
+		brackets []Bracket
+		want     int
+		wantErr  bool
+	}{
+		{"below the first bracket", 50, brackets, 500, false},
+		{"weight equal to UpToGrams belongs to that bracket", 100, brackets, 500, false},
+		{"weight equal to the second UpToGrams belongs to the second", 500, brackets, 900, false},
+		{"overflow beyond the last bracket uses the last bracket", 600, brackets, 900, false},
+		{"negative weight is rejected", -1, brackets, 0, true},
+		{"empty brackets are rejected", 100, []Bracket{}, 0, true},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := Rate(tt.weight, tt.brackets)
+			if tt.wantErr {
+				if err == nil {
+					t.Fatalf("Rate(%d) expected an error, got nil", tt.weight)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("Rate(%d) unexpected error: %v", tt.weight, err)
+			}
+			if got != tt.want {
+				t.Fatalf("Rate(%d) = %d, want %d", tt.weight, got, tt.want)
+			}
+		})
+	}
+}
