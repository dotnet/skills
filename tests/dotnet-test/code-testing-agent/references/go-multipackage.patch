@@ -0,0 +1,82 @@
+package order
+
+import (
+	"errors"
+	"testing"
+)
+
+type fakeDiscountPolicy struct {
+	value int
+	err   error
+	calls int
+}
+
+func (f *fakeDiscountPolicy) Discount(subtotalCents int) (int, error) {
+	f.calls++
+	return f.value, f.err
+}
+
+type fakeShippingCalculator struct {
+	value int
+	err   error
+	calls int
+}
+
+func (f *fakeShippingCalculator) Rate(weightGrams int) (int, error) {
+	f.calls++
+	return f.value, f.err
+}
+
+func TestTotalComposesSubtotalDiscountAndShipping(t *testing.T) {
+	discount := &fakeDiscountPolicy{value: 250}
+	shipping := &fakeShippingCalculator{value: 900}
+
+	got, err := Total(1000, 200, discount, shipping)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	// subtotal - discount + shipping = 1000 - 250 + 900 = 1650
+	if got != 1650 {
+		t.Fatalf("Total = %d, want 1650", got)
+	}
+	if discount.calls != 1 || shipping.calls != 1 {
+		t.Fatalf("expected one call to each collaborator, got discount=%d shipping=%d", discount.calls, shipping.calls)
+	}
+}
+
+func TestTotalRejectsNegativeSubtotalWithoutCallingCollaborators(t *testing.T) {
+	discount := &fakeDiscountPolicy{value: 250}
+	shipping := &fakeShippingCalculator{value: 900}
+
+	if _, err := Total(-1, 200, discount, shipping); err == nil {
+		t.Fatalf("expected an error for a negative subtotal")
+	}
+	if discount.calls != 0 || shipping.calls != 0 {
+		t.Fatalf("collaborators must not be called for an invalid subtotal, got discount=%d shipping=%d", discount.calls, shipping.calls)
+	}
+}
+
+func TestTotalShortCircuitsWhenDiscountFails(t *testing.T) {
+	discount := &fakeDiscountPolicy{err: errors.New("discount failed")}
+	shipping := &fakeShippingCalculator{value: 900}
+
+	if _, err := Total(1000, 200, discount, shipping); err == nil {
+		t.Fatalf("expected the discount error to propagate")
+	}
+	if shipping.calls != 0 {
+		t.Fatalf("shipping must not be called when discount fails, got %d calls", shipping.calls)
+	}
+}
+
+func TestTotalPropagatesShippingError(t *testing.T) {
+	discount := &fakeDiscountPolicy{value: 250}
+	shipping := &fakeShippingCalculator{err: errors.New("no rate")}
+
+	if _, err := Total(1000, 200, discount, shipping); err == nil {
+		t.Fatalf("expected the shipping error to propagate")
+	}
+	if discount.calls != 1 {
+		t.Fatalf("discount should be called once before shipping fails, got %d calls", discount.calls)
+	}
+}
