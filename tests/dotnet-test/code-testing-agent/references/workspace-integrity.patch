+import pytest
+
+from synthstr.stringy import is_palindrome, reverse, truncate, word_count
+
+
+def test_reverse_reverses_characters():
+    assert reverse("abc") == "cba"
+    assert reverse("") == ""
+
+
+def test_is_palindrome_ignores_case_and_punctuation():
+    assert is_palindrome("A man, a plan, a canal: Panama") is True
+    assert is_palindrome("hello") is False
+
+
+def test_word_count_counts_whitespace_delimited_words():
+    assert word_count("a b  c") == 3
+    assert word_count("   ") == 0
+
+
+def test_truncate_returns_input_when_within_limit():
+    assert truncate("hello", 10) == "hello"
+
+
+def test_truncate_adds_ellipsis_when_shortened():
+    result = truncate("hello world", 8)
+    assert result == "hello w\u2026"
+    assert len(result) == 8
+
+
+def test_truncate_zero_limit_is_empty():
+    assert truncate("hello", 0) == ""
+
+
+def test_truncate_negative_limit_raises():
+    with pytest.raises(ValueError):
+        truncate("hello", -1)
