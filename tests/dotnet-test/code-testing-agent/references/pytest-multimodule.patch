@@ -0,0 +1,36 @@
+import pytest
+
+from analytics.stats import mean, percentile
+
+
+def test_mean_returns_average():
+    assert mean([2, 4, 6]) == 4.0
+
+
+def test_mean_empty_raises():
+    with pytest.raises(ValueError):
+        mean([])
+
+
+def test_percentile_empty_raises():
+    with pytest.raises(ValueError):
+        percentile([], 50)
+
+
+@pytest.mark.parametrize("bad", [-1, 101])
+def test_percentile_out_of_range_raises(bad):
+    with pytest.raises(ValueError):
+        percentile([1, 2, 3], bad)
+
+
+def test_percentile_zero_and_hundred_boundaries():
+    values = [10, 20, 30, 40, 50]
+    assert percentile(values, 0) == 10
+    assert percentile(values, 100) == 50
+
+
+def test_percentile_orders_unsorted_input():
+    values = [50, 10, 40, 20, 30]
+    assert percentile(values, 0) == 10
+    assert percentile(values, 100) == 50
+    assert percentile(values, 50) == 30
