@@ -0,0 +1,21 @@
+import pytest
+
+from textkit.slug import slugify
+
+
+def test_collapses_and_trims_separators():
+    assert slugify("  Hello,  World!  ") == "hello-world"
+
+
+def test_returns_slug_unchanged_within_max_length():
+    assert slugify("hello world", max_length=48) == "hello-world"
+
+
+def test_truncates_and_strips_trailing_hyphen():
+    # slug is "aaaa-bbbb"; truncating to 5 chars yields "aaaa-" which is trimmed.
+    assert slugify("aaaa bbbb", max_length=5) == "aaaa"
+
+
+def test_invalid_max_length_raises():
+    with pytest.raises(ValueError):
+        slugify("hello", max_length=0)
