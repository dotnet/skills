+import pytest
+
+from analytics.window import RateWindow
+
+
+@pytest.mark.parametrize("bad_capacity", [0, -1])
+def test_constructor_rejects_non_positive_capacity(bad_capacity):
+    with pytest.raises(ValueError):
+        RateWindow(bad_capacity)
+
+
+def test_average_on_empty_window_raises():
+    with pytest.raises(RuntimeError):
+        RateWindow(3).average()
+
+
+def test_peak_on_empty_window_raises():
+    with pytest.raises(RuntimeError):
+        RateWindow(3).peak()
+
+
+def test_average_and_peak_before_rollover():
+    window = RateWindow(3)
+    window.add(2)
+    window.add(4)
+    assert window.average() == 3.0
+    assert window.peak() == 4
+
+
+def test_capacity_rollover_drops_oldest():
+    window = RateWindow(3)
+    for value in (1, 2, 3, 4):
+        window.add(value)
+    # Oldest sample (1) rolled out; window holds [2, 3, 4].
+    assert window.average() == 3.0
+    assert window.peak() == 4
