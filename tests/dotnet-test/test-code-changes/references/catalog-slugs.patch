index 0000000..58cff53
--- /dev/null
+++ b/tests/Catalog.Tests/SlugHelperTests.cs
@@ -0,0 +1,32 @@
+using Catalog;
+
+namespace Catalog.Tests;
+
+public class SlugHelperTests
+{
+    [Theory]
+    [InlineData("Tools & Hardware", "tools-hardware")]
+    [InlineData("Soap -- Bars", "soap-bars")]
+    public void ToSlug_RunOfSeparators_CollapsesToOneDash(string text, string expected)
+    {
+        Assert.Equal(expected, SlugHelper.ToSlug(text));
+    }
+
+    [Fact]
+    public void ToSlug_SeparatorsAtTheEnds_AreTrimmed()
+    {
+        Assert.Equal("sale", SlugHelper.ToSlug("--Sale!!--"));
+    }
+
+    [Fact]
+    public void ToSlug_SingleSeparator_IsUnchanged()
+    {
+        Assert.Equal("garden-tools", SlugHelper.ToSlug("Garden Tools"));
+    }
+
+    [Fact]
+    public void ToSlug_OnlySeparators_IsEmpty()
+    {
+        Assert.Equal("", SlugHelper.ToSlug("!!!"));
+    }
+}
