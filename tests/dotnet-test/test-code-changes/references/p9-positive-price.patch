+using System.Net;
+using System.Text.RegularExpressions;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Xunit;
+
+namespace Catalog.BrowserTests;
+
+public sealed class CreatePageHttpTests(WebApplicationFactory<Program> factory)
+    : IClassFixture<WebApplicationFactory<Program>>
+{
+    [Theory]
+    [InlineData("0")]
+    [InlineData("-1")]
+    public async Task Rejects_a_non_positive_price(string price)
+    {
+        using var client = factory.CreateClient(new() { AllowAutoRedirect = false });
+        using var response = await PostProduct(client, price);
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var markup = await response.Content.ReadAsStringAsync();
+        var priceError = Regex.Match(markup, """<span\b[^>]*\bdata-valmsg-for="Price"[^>]*>([^<]*)</span>""");
+        Assert.True(priceError.Success, "The form must render a validation message for Price.");
+        Assert.Equal("Price must be greater than zero.", WebUtility.HtmlDecode(priceError.Groups[1].Value));
+    }
+
+    [Fact]
+    public async Task Accepts_a_positive_price()
+    {
+        using var client = factory.CreateClient(new() { AllowAutoRedirect = false });
+        using var response = await PostProduct(client, "1");
+
+        Assert.Equal(HttpStatusCode.Redirect, response.StatusCode);
+        Assert.Equal("/", response.Headers.Location?.OriginalString);
+    }
+
+    private static async Task<HttpResponseMessage> PostProduct(HttpClient client, string price)
+    {
+        const string url = "/Products/Create";
+        var markup = await client.GetStringAsync(url);
+        var token = Regex.Match(markup, """name="__RequestVerificationToken"[^>]*value="([^"]+)"(?=[\s>])""");
+        Assert.True(token.Success, "The form must issue an antiforgery token.");
+        using var form = new FormUrlEncodedContent(new Dictionary<string, string>
+        {
+            ["Name"] = "Desk tray",
+            ["Price"] = price,
+            ["__RequestVerificationToken"] = WebUtility.HtmlDecode(token.Groups[1].Value)
+        });
+        return await client.PostAsync(url, form);
+    }
+}
