@@ -0,0 +1,14 @@
+using Xunit;
+
+namespace Reporting.Tests;
+
+public sealed class CsvExporterTests
+{
+    [Fact]
+    public void Quotes_a_comma_field_but_leaves_plain_fields_unquoted()
+    {
+        var output = CsvExporter.Export([["Region", "North, Central", "8"]]);
+
+        Assert.Equal("Region,\"North, Central\",8", output);
+    }
+}
