diff --git a/src/Timing/DurationParser.cs b/src/Timing/DurationParser.cs
index c962514..0c7ec6e 100644
--- a/src/Timing/DurationParser.cs
+++ b/src/Timing/DurationParser.cs
@@ -13,22 +13,21 @@ public static partial class DurationParser
     public static bool TryParse(string? text, out TimeSpan duration)
     {
         duration = TimeSpan.Zero;
-        var match = Component().Match(text?.Trim() ?? "");
-        if (!match.Success)
+        var match = Components().Match(text?.Trim() ?? "");
+        if (!match.Success || match.Length == 0)
         {
             return false;
         }
 
-        var value = int.Parse(match.Groups["value"].Value, CultureInfo.InvariantCulture);
-        duration = match.Groups["unit"].Value switch
-        {
-            "h" => TimeSpan.FromHours(value),
-            "m" => TimeSpan.FromMinutes(value),
-            _ => TimeSpan.FromSeconds(value),
-        };
+        duration = TimeSpan.FromHours(ValueOf(match, "hours"))
+            + TimeSpan.FromMinutes(ValueOf(match, "minutes"))
+            + TimeSpan.FromSeconds(ValueOf(match, "seconds"));
         return true;
     }
 
-    [GeneratedRegex(@"^(?<value>\d+)(?<unit>[hms])", RegexOptions.CultureInvariant)]
-    private static partial Regex Component();
+    private static int ValueOf(Match match, string group) =>
+        match.Groups[group].Success ? int.Parse(match.Groups[group].Value, CultureInfo.InvariantCulture) : 0;
+
+    [GeneratedRegex(@"^(?:(?<hours>\d+)h)?(?:(?<minutes>\d+)m)?(?:(?<seconds>\d+)s)?$", RegexOptions.CultureInvariant)]
+    private static partial Regex Components();
 }
