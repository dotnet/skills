+using Xunit;
+
+namespace ReceiptRenamer.Tests;
+
+public sealed class RenameCommandTests
+{
+    [Theory]
+    [InlineData(true)]
+    [InlineData(false)]
+    public void Reports_the_rename_but_only_moves_a_file_without_dry_run(bool dryRun)
+    {
+        var folder = Directory.CreateTempSubdirectory("receipt-");
+        try
+        {
+            var source = Path.Combine(folder.FullName, "Receipt July.PDF");
+            var destination = Path.Combine(folder.FullName, "receipt-july.pdf");
+            File.WriteAllText(source, "receipt data");
+            using var output = new StringWriter();
+            string[] args = dryRun ? ["--dry-run", source] : [source];
+
+            Assert.Equal(0, RenameCommand.Run(args, output));
+
+            Assert.Equal($"Receipt July.PDF -> receipt-july.pdf{Environment.NewLine}", output.ToString());
+            Assert.Equal(dryRun, File.Exists(source));
+            Assert.Equal(!dryRun, File.Exists(destination));
+            Assert.Equal("receipt data", File.ReadAllText(dryRun ? source : destination));
+        }
+        finally
+        {
+            folder.Delete(recursive: true);
+        }
+    }
+}
