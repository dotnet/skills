+using System;
+using System.Threading.Tasks;
+using Features;
+using Xunit;
+
+public class FeatureFlagsScopedEnvTests
+{
+    [Fact]
+    public void InnerScope_RestoresOuter_EvenWhenInnerThrows()
+    {
+        using (FeatureFlags.OverrideEnvironment(_ => "true"))
+        {
+            Assert.True(FeatureFlags.IsEnabled("X"));
+            try
+            {
+                using (FeatureFlags.OverrideEnvironment(_ => "false"))
+                {
+                    Assert.False(FeatureFlags.IsEnabled("X"));
+                    throw new InvalidOperationException("boom");
+                }
+            }
+            catch (InvalidOperationException)
+            {
+            }
+
+            Assert.True(FeatureFlags.IsEnabled("X"));
+        }
+    }
+
+    [Fact]
+    public async Task ParallelFlows_DoNotLeakProvider()
+    {
+        async Task<bool> Flow(string v)
+        {
+            using (FeatureFlags.OverrideEnvironment(_ => v))
+            {
+                await Task.Yield();
+                await Task.Delay(1);
+                return FeatureFlags.IsEnabled("ANY");
+            }
+        }
+
+        var results = await Task.WhenAll(Flow("true"), Flow("false"), Flow("true"));
+        Assert.Equal(new[] { true, false, true }, results);
+    }
+
+    [Fact]
+    public void DefaultPath_ReadsRealEnvironment()
+    {
+        Assert.False(FeatureFlags.IsEnabled("DEFINITELY_NOT_SET_" + Guid.NewGuid().ToString("N")));
+    }
+}
