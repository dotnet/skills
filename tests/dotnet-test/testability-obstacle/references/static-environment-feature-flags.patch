+        string.Equals(Provider(name), "true", StringComparison.OrdinalIgnoreCase);
+
+    public static IDisposable OverrideEnvironment(Func<string, string?> provider)
+    {
+        var previous = s_provider.Value;
+        s_provider.Value = provider;
+        return new Restore(() => s_provider.Value = previous);
