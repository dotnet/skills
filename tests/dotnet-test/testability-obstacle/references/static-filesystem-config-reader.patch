+using System.Collections.Generic;
+using System.Linq;
+using System.Threading.Tasks;
+using LegacyConfiguration;
+using Xunit;
+
+public class LegacyConfigScopedStoreTests
+{
+    private sealed class FakeStore : IFileStore
+    {
+        private readonly Dictionary<string, string> _files;
+        public FakeStore(Dictionary<string, string> files) => _files = files;
+        public bool Exists(string path) => _files.ContainsKey(path);
+        public string ReadAllText(string path) => _files[path];
+    }
+
+    [Fact]
+    public void InnerDisposal_RestoresOuterStore_Nested()
+    {
+        var outer = new FakeStore(new() { ["c.txt"] = "outer" });
+        var inner = new FakeStore(new() { ["c.txt"] = "inner" });
+        using (LegacyConfig.OverrideStore(outer))
+        {
+            Assert.Equal("outer", LegacyConfig.Read("c.txt"));
+            using (LegacyConfig.OverrideStore(inner))
+            {
+                Assert.Equal("inner", LegacyConfig.Read("c.txt"));
+            }
+            Assert.Equal("outer", LegacyConfig.Read("c.txt"));
+        }
+    }
+
+    [Fact]
+    public async Task ParallelFlows_StayIsolated()
+    {
+        async Task<string?> Flow(string val)
+        {
+            using (LegacyConfig.OverrideStore(new FakeStore(new() { ["k"] = val })))
+            {
+                await Task.Yield();
+                await Task.Delay(1);
+                return LegacyConfig.Read("k");
+            }
+        }
+
+        var results = await Task.WhenAll(Flow("a"), Flow("b"), Flow("c"));
+        Assert.Equal(new[] { "a", "b", "c" }, results.OrderBy(x => x).ToArray());
+    }
+
+    [Fact]
+    public void DefaultPath_MissingFile_ReturnsNull()
+    {
+        Assert.Null(LegacyConfig.Read("this-file-does-not-exist-xyz.cfg"));
+    }
+}
