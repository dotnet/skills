@@ -0,0 +1,45 @@
+import io
+from datetime import datetime
+
+from report_writer import write_report
+
+
+class _Buffer:
+    def __init__(self):
+        self._data = []
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *exc):
+        return False
+
+    def write(self, data):
+        self._data.append(data)
+        return len(data)
+
+    def getvalue(self):
+        return "".join(self._data)
+
+
+def test_timestamped_filename_is_deterministic():
+    fixed = lambda: datetime(2024, 1, 2, 3, 4, 5)
+    captured = {}
+
+    def fake_opener(name, mode):
+        captured["name"] = name
+        captured["buffer"] = _Buffer()
+        return captured["buffer"]
+
+    result = write_report("daily", "hello", now=fixed, opener=fake_opener)
+
+    assert result == "daily-20240102-030405.txt"
+    assert captured["name"] == result
+    assert captured["buffer"].getvalue() == "hello"
+
+
+def test_default_opener_writes_real_file(tmp_path):
+    target = tmp_path / "report"
+    result = write_report(str(target), "world")
+    with open(result, encoding="utf-8") as handle:
+        assert handle.read() == "world"
