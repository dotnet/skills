+using System;
+using System.Threading.Tasks;
+using Correlation;
+using Xunit;
+
+public class CorrelationIdsScopedGeneratorTests
+{
+    [Fact]
+    public void InnerDisposal_RestoresOuterGenerator_Nested()
+    {
+        var a = Guid.Parse("11111111-1111-1111-1111-111111111111");
+        var b = Guid.Parse("22222222-2222-2222-2222-222222222222");
+        using (CorrelationIds.OverrideGenerator(() => a))
+        {
+            Assert.Equal("req-" + a.ToString("N"), CorrelationIds.Create("req"));
+            using (CorrelationIds.OverrideGenerator(() => b))
+            {
+                Assert.Equal("req-" + b.ToString("N"), CorrelationIds.Create("req"));
+            }
+            Assert.Equal("req-" + a.ToString("N"), CorrelationIds.Create("req"));
+        }
+    }
+
+    [Fact]
+    public async Task ParallelFlows_StayIsolated()
+    {
+        async Task<string> Flow(Guid g)
+        {
+            using (CorrelationIds.OverrideGenerator(() => g))
+            {
+                await Task.Yield();
+                await Task.Delay(1);
+                return CorrelationIds.Create("id");
+            }
+        }
+
+        var g1 = Guid.NewGuid();
+        var g2 = Guid.NewGuid();
+        var g3 = Guid.NewGuid();
+        var results = await Task.WhenAll(Flow(g1), Flow(g2), Flow(g3));
+        Assert.Equal("id-" + g1.ToString("N"), results[0]);
+        Assert.Equal("id-" + g2.ToString("N"), results[1]);
+        Assert.Equal("id-" + g3.ToString("N"), results[2]);
+    }
+
+    [Fact]
+    public void DefaultPath_UsesRandomGuid()
+    {
+        var one = CorrelationIds.Create("x");
+        var two = CorrelationIds.Create("x");
+        Assert.NotEqual(one, two);
+        Assert.StartsWith("x-", one);
+    }
+}
