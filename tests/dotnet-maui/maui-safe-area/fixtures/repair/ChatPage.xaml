<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SafeAreaSample.ChatPage"
    SafeAreaEdges="None">
    <Grid RowDefinitions="*,Auto" SafeAreaEdges="Container">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout>
                <Label Text="Messages" />
            </VerticalStackLayout>
        </ScrollView>
        <Grid Grid.Row="1">
            <Entry Placeholder="Message" />
        </Grid>
    </Grid>
</ContentPage>
