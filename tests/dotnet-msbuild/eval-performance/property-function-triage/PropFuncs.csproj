<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Cheap: a plain in-memory string transform, no I/O, negligible cost. -->
    <NormalizedConfig>$(Configuration.ToUpperInvariant())</NormalizedConfig>
    <!-- Expensive: reads a file from disk on every evaluation. -->
    <ReleaseNotes Condition="Exists('$(MSBuildProjectDirectory)\notes.txt')">$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\notes.txt'))</ReleaseNotes>
  </PropertyGroup>
</Project>
