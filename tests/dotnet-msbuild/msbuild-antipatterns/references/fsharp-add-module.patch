new file mode 100644
--- /dev/null
+++ b/fsharp/OrderService/Validation.fs
@@ -0,0 +1,11 @@
+module OrderService.Validation
+
+open OrderService.Domain
+
+let validateOrder (order: Order) : Result<Order, string> =
+    if List.isEmpty order.Items then
+        Error "Order must have at least one item"
+    elif System.String.IsNullOrWhiteSpace order.CustomerName then
+        Error "Customer name must not be empty"
+    else
+        Ok order
