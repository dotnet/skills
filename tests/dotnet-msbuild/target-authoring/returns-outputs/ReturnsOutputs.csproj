<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <!-- Query target that referencing projects call through the MSBuild task.
       Outputs is the legacy caller-return fallback when Returns is absent. -->
  <Target Name="GetApiVersion" Outputs="@(ApiVersion)">
    <ItemGroup>
      <ApiVersion Include="2.3.1" />
    </ItemGroup>
  </Target>
</Project>
