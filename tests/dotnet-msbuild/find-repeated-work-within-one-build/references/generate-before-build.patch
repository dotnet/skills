@@ -1,4 +1,18 @@
 #!/usr/bin/env bash
 set -euo pipefail
 
+mkdir -p obj
+generated="$(mktemp obj/buildinfo.XXXXXX)"
+trap 'rm -f "$generated"' EXIT
+sh tools/make-buildinfo.sh "$generated"
+if [ ! -e obj/buildinfo.g.cs ]; then
+    mv "$generated" obj/buildinfo.g.cs
+elif cmp "$generated" obj/buildinfo.g.cs >/dev/null; then
+    :
+else
+    status=$?
+    [ "$status" -eq 1 ] || exit "$status"
+    mv "$generated" obj/buildinfo.g.cs
+fi
+
 dotnet build Contoso.slnx -c Release -m
