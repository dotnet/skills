<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Target Name="GenerateVersionInfo" AfterTargets="Build">
    <ItemGroup>
      <VersionInfoLines Include="namespace VersionedApp%3B" />
      <VersionInfoLines Include="public static class VersionInfo { public const string Version = &quot;1.0.0&quot;%3B }" />
    </ItemGroup>
    <WriteLinesToFile File="VersionInfo.cs" Lines="@(VersionInfoLines)" Overwrite="true" />
  </Target>
</Project>
