+
+        @if (departments.Count == 0)
+        {
+            <p class="alert alert-warning">Create a <a href="departments">department</a> before adding employees.</p>
+        }
+
+        @if (employees.Count == 0)
+        {
+            <p>No employees have been added.</p>
+        }
+        else
+        {
+            <table class="table table-striped align-middle">
+                <thead>
+                    <tr>
+                        <th>Name</th>
+                        <th>Email</th>
+                        <th>Department</th>
+                        <th><span class="visually-hidden">Actions</span></th>
+                    </tr>
+                </thead>
+                <tbody>
+                    @foreach (var employee in employees)
+                    {
+                        <tr>
+                            <td>@employee.FirstName @employee.LastName</td>
+                            <td>@employee.Email</td>
+                            <td>@employee.Department.Name</td>
+                            <td class="text-nowrap">
+                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => SelectEmployeeAsync(employee.Id)">Details</button>
+                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => EditEmployeeAsync(employee.Id)">Edit</button>
+                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveEmployeeAsync(employee.Id)">Delete</button>
+                            </td>
+                        </tr>
+                    }
+                </tbody>
+            </table>
+        }
+
+        @if (selectedEmployee is not null)
+        {
+            <section class="card mt-3" aria-labelledby="employee-details-heading">
+                <div class="card-body">
+                    <h2 id="employee-details-heading" class="h5">Employee details</h2>
+                    <dl class="row mb-0">
+                        <dt class="col-sm-4">Name</dt>
+                        <dd class="col-sm-8">@selectedEmployee.FirstName @selectedEmployee.LastName</dd>
+                        <dt class="col-sm-4">Email</dt>
+                        <dd class="col-sm-8">@selectedEmployee.Email</dd>
+                        <dt class="col-sm-4">Department</dt>
+                        <dd class="col-sm-8">@selectedEmployee.Department.Name</dd>
+                    </dl>
+                </div>
+            </section>
+        }
+    </div>
+
+    <div class="col-lg-5">
+        <h2 class="h4">@(employeeForm.Id == 0 ? "Create employee" : "Edit employee")</h2>
+        <EditForm Model="@employeeForm" OnValidSubmit="SaveEmployeeAsync" @key="employeeForm">
+            <DataAnnotationsValidator />
+            <ValidationSummary />
+
+            <div class="mb-3">
+                <label class="form-label" for="employee-first-name">First name</label>
+                <InputText id="employee-first-name" class="form-control" @bind-Value="employeeForm.FirstName" />
+                <ValidationMessage For="@(() => employeeForm.FirstName)" />
+            </div>
+            <div class="mb-3">
+                <label class="form-label" for="employee-last-name">Last name</label>
+                <InputText id="employee-last-name" class="form-control" @bind-Value="employeeForm.LastName" />
+                <ValidationMessage For="@(() => employeeForm.LastName)" />
+            </div>
+            <div class="mb-3">
+                <label class="form-label" for="employee-email">Email</label>
+                <InputText id="employee-email" class="form-control" @bind-Value="employeeForm.Email" />
+                <ValidationMessage For="@(() => employeeForm.Email)" />
+            </div>
+            <div class="mb-3">
+                <label class="form-label" for="employee-department">Department</label>
+                <InputSelect id="employee-department" class="form-select" @bind-Value="employeeForm.DepartmentId">
