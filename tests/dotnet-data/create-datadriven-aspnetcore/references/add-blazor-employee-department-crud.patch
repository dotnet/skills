+@page "/departments"
+@rendermode InteractiveServer
+@using BlazorApp.Data
+@using BlazorApp.Models
+@using Microsoft.EntityFrameworkCore
+@inject IDbContextFactory<AppDbContext> DbFactory
+
+<PageTitle>Departments</PageTitle>
+
+<h1>Departments</h1>
+
+@if (!string.IsNullOrWhiteSpace(statusMessage))
+{
+    <div class="alert alert-info" role="status">@statusMessage</div>
+}
+
+<div class="row g-4">
+    <div class="col-lg-7">
+        <div class="d-flex justify-content-between align-items-center mb-3">
+            <h2 class="h4 mb-0">Department list</h2>
+            <button type="button" class="btn btn-primary" @onclick="StartCreate">New department</button>
+        </div>
+
+        @if (departments.Count == 0)
+        {
+            <p>No departments have been added.</p>
+        }
+        else
+        {
+            <table class="table table-striped align-middle">
+                <thead>
+                    <tr>
+                        <th>Name</th>
+                        <th>Employees</th>
+                        <th><span class="visually-hidden">Actions</span></th>
+                    </tr>
+                </thead>
+                <tbody>
+                    @foreach (var department in departments)
+                    {
+                        <tr>
+                            <td>@department.Name</td>
+                            <td>@department.Employees.Count</td>
+                            <td class="text-nowrap">
+                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => SelectDepartmentAsync(department.Id)">Details</button>
+                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => EditDepartmentAsync(department.Id)">Edit</button>
+                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveDepartmentAsync(department.Id)">Delete</button>
+                            </td>
+                        </tr>
+                    }
+                </tbody>
+            </table>
+        }
+
+        @if (selectedDepartment is not null)
+        {
+            <section class="card mt-3" aria-labelledby="department-details-heading">
+                <div class="card-body">
+                    <h2 id="department-details-heading" class="h5">Department details</h2>
+                    <p><strong>Name:</strong> @selectedDepartment.Name</p>
+                    <p class="mb-1"><strong>Employees:</strong></p>
+                    @if (selectedDepartment.Employees.Count == 0)
+                    {
+                        <p class="mb-0">No employees are assigned.</p>
+                    }
+                    else
+                    {
+                        <ul class="mb-0">
+                            @foreach (var employee in selectedDepartment.Employees.OrderBy(employee => employee.LastName))
+                            {
+                                <li>@employee.FirstName @employee.LastName</li>
+                            }
+                        </ul>
+                    }
+                </div>
+            </section>
+        }
+    </div>
+
+    <div class="col-lg-5">
+        <h2 class="h4">@(departmentForm.Id == 0 ? "Create department" : "Edit department")</h2>
+        <EditForm Model="@departmentForm" OnValidSubmit="SaveDepartmentAsync" @key="departmentForm">
+            <DataAnnotationsValidator />
+            <ValidationSummary />
+
+            <div class="mb-3">
+                <label class="form-label" for="department-name">Name</label>
+                <InputText id="department-name" class="form-control" @bind-Value="departmentForm.Name" />
+                <ValidationMessage For="@(() => departmentForm.Name)" />
+            </div>
+            <button type="submit" class="btn btn-primary">Save department</button>
+            <button type="button" class="btn btn-secondary ms-2" @onclick="StartCreate">Cancel</button>
+        </EditForm>
+    </div>
+</div>
+
+@code {
+    private List<Department> departments = [];
+    private Department departmentForm = new();
+    private Department? selectedDepartment;
+    private string? statusMessage;
+
+    protected override Task OnInitializedAsync() => LoadDepartmentsAsync();
+
+    private async Task LoadDepartmentsAsync()
+    {
+        await using var db = await DbFactory.CreateDbContextAsync();
+        departments = await db.Departments.AsNoTracking()
+            .Include(department => department.Employees)
+            .OrderBy(department => department.Name)
+            .ToListAsync();
+
+        if (selectedDepartment is not null)
+        {
+            selectedDepartment = await db.Departments.AsNoTracking()
+                .Include(department => department.Employees)
+                .FirstOrDefaultAsync(department => department.Id == selectedDepartment.Id);
+        }
+    }
+
+    private void StartCreate()
+    {
+        departmentForm = new();
+        statusMessage = null;
+    }
+
+    private async Task SelectDepartmentAsync(int id)
+    {
+        await using var db = await DbFactory.CreateDbContextAsync();
+        selectedDepartment = await db.Departments.AsNoTracking()
+            .Include(department => department.Employees)
+            .FirstOrDefaultAsync(department => department.Id == id);
+    }
+
+    private async Task EditDepartmentAsync(int id)
+    {
+        await using var db = await DbFactory.CreateDbContextAsync();
+        var department = await db.Departments.AsNoTracking().FirstOrDefaultAsync(item => item.Id == id);
+        if (department is null)
+        {
+            statusMessage = "The department no longer exists.";
+            return;
+        }
+
+        departmentForm = new Department { Id = department.Id, Name = department.Name };
+        statusMessage = null;
+    }
+
+    private async Task SaveDepartmentAsync()
+    {
+        var wasNew = departmentForm.Id == 0;
+        if (wasNew)
+        {
+            await AddDepartmentAsync(departmentForm);
+        }
+        else if (!await UpdateDepartmentAsync(departmentForm))
+        {
+            return;
+        }
+
+        statusMessage = wasNew ? "Department added." : "Department updated.";
+        departmentForm = new();
+        await LoadDepartmentsAsync();
+    }
+
+    private async Task AddDepartmentAsync(Department model)
+    {
+        await using var db = await DbFactory.CreateDbContextAsync();
+        await db.Departments.AddAsync(new Department { Name = model.Name });
+        await db.SaveChangesAsync();
+    }
+
+    private async Task<bool> UpdateDepartmentAsync(Department model)
+    {
+        await using var db = await DbFactory.CreateDbContextAsync();
+        var department = await db.Departments.FindAsync(model.Id);
+        if (department is null)
+        {
+            statusMessage = "The department no longer exists.";
+            return false;
+        }
+
+        department.Name = model.Name;
+        await db.SaveChangesAsync();
+        return true;
+    }
+
+    private async Task RemoveDepartmentAsync(int id)
+    {
+        await using var db = await DbFactory.CreateDbContextAsync();
+        if (await db.Employees.AnyAsync(employee => employee.DepartmentId == id))
+        {
+            statusMessage = "Move or delete the department's employees before deleting it.";
+            return;
+        }
+
+        var department = await db.Departments.FindAsync(id);
+        if (department is null)
+        {
+            statusMessage = "The department no longer exists.";
+            return;
+        }
+
+        db.Departments.Remove(department);
+        await db.SaveChangesAsync();
+        if (selectedDepartment?.Id == id)
+        {
+            selectedDepartment = null;
+        }
+        statusMessage = "Department deleted.";
+        await LoadDepartmentsAsync();
+    }
+}
