+                        <option value="@department.Id">@department.Name</option>
+                    }
+                </InputSelect>
+                <ValidationMessage For="@(() => employeeForm.DepartmentId)" />
+            </div>
+            <button type="submit" class="btn btn-primary" disabled="@(departments.Count == 0)">Save employee</button>
+            <button type="button" class="btn btn-secondary ms-2" @onclick="StartCreate">Cancel</button>
+        </EditForm>
+    </div>
+</div>
+
+@code {
+    private List<Employee> employees = [];
+    private List<Department> departments = [];
+    private Employee employeeForm = new();
+    private Employee? selectedEmployee;
+    private string? statusMessage;
+
+    protected override Task OnInitializedAsync() => LoadEmployeesAsync();
+
+    private async Task LoadEmployeesAsync()
+    {
+        await using var db = await DbFactory.CreateDbContextAsync();
+        departments = await db.Departments.AsNoTracking().OrderBy(department => department.Name).ToListAsync();
+        employees = await db.Employees.AsNoTracking()
+            .Include(employee => employee.Department)
+            .OrderBy(employee => employee.LastName)
+            .ThenBy(employee => employee.FirstName)
+            .ToListAsync();
+
+        if (selectedEmployee is not null)
+        {
+            selectedEmployee = await db.Employees.AsNoTracking()
+                .Include(employee => employee.Department)
+                .FirstOrDefaultAsync(employee => employee.Id == selectedEmployee.Id);
+        }
+    }
+
+    private void StartCreate()
+    {
+        employeeForm = new();
+        statusMessage = null;
+    }
+
+    private async Task SelectEmployeeAsync(int id)
+    {
+        await using var db = await DbFactory.CreateDbContextAsync();
+        selectedEmployee = await db.Employees.AsNoTracking()
+            .Include(employee => employee.Department)
+            .FirstOrDefaultAsync(employee => employee.Id == id);
+    }
+
+    private async Task EditEmployeeAsync(int id)
+    {
+        await using var db = await DbFactory.CreateDbContextAsync();
+        var employee = await db.Employees.AsNoTracking().FirstOrDefaultAsync(item => item.Id == id);
+        if (employee is null)
+        {
+            statusMessage = "The employee no longer exists.";
+            return;
+        }
+
+        employeeForm = new Employee
+        {
+            Id = employee.Id,
+            FirstName = employee.FirstName,
+            LastName = employee.LastName,
+            Email = employee.Email,
+            DepartmentId = employee.DepartmentId
+        };
+        statusMessage = null;
+    }
+
+    private async Task SaveEmployeeAsync()
+    {
+        var wasNew = employeeForm.Id == 0;
+        if (wasNew)
+        {
+            await AddEmployeeAsync(employeeForm);
+        }
+        else if (!await UpdateEmployeeAsync(employeeForm))
+        {
+            return;
+        }
+
+        statusMessage = wasNew ? "Employee added." : "Employee updated.";
+        employeeForm = new();
+        await LoadEmployeesAsync();
+    }
+
+    private async Task AddEmployeeAsync(Employee model)
+    {
+        await using var db = await DbFactory.CreateDbContextAsync();
+        await db.Employees.AddAsync(new Employee
+        {
+            FirstName = model.FirstName,
+            LastName = model.LastName,
+            Email = model.Email,
+            DepartmentId = model.DepartmentId
+        });
+        await db.SaveChangesAsync();
+    }
+
+    private async Task<bool> UpdateEmployeeAsync(Employee model)
+    {
+        await using var db = await DbFactory.CreateDbContextAsync();
+        var employee = await db.Employees.FindAsync(model.Id);
+        if (employee is null)
+        {
+            statusMessage = "The employee no longer exists.";
+            return false;
+        }
+
+        employee.FirstName = model.FirstName;
+        employee.LastName = model.LastName;
+        employee.Email = model.Email;
+        employee.DepartmentId = model.DepartmentId;
+        await db.SaveChangesAsync();
+        return true;
+    }
+
+    private async Task RemoveEmployeeAsync(int id)
+    {
+        await using var db = await DbFactory.CreateDbContextAsync();
+        var employee = await db.Employees.FindAsync(id);
+        if (employee is null)
+        {
+            statusMessage = "The employee no longer exists.";
+            return;
+        }
+
+        db.Employees.Remove(employee);
+        await db.SaveChangesAsync();
+        if (selectedEmployee?.Id == id)
+        {
+            selectedEmployee = null;
+        }
+        statusMessage = "Employee deleted.";
+        await LoadEmployeesAsync();
+    }
+}
