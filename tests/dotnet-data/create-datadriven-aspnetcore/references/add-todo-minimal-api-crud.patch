@@ -0,0 +1,145 @@
+using Microsoft.EntityFrameworkCore;
+using TodoApi.Data;
+using TodoApi.Models;
+
+namespace TodoApi.Endpoints;
+
+public static class TodoEndpoints
+{
+    public static IEndpointRouteBuilder MapTodoEndpoints(this IEndpointRouteBuilder endpoints)
+    {
+        var group = endpoints.MapGroup("/api/todos").WithTags("Todos");
+
+        group.MapGet("", GetTodosAsync)
+            .WithName("GetTodoItems")
+            .WithSummary("List todo items")
+            .WithDescription("Returns every todo item ordered by its server-assigned identifier.")
+            .Produces<List<TodoItem>>(StatusCodes.Status200OK);
+
+        group.MapGet("/{id:int}", GetTodoByIdAsync)
+            .WithName("GetTodoItemById")
+            .WithSummary("Get one todo item")
+            .WithDescription("Returns the todo item with the requested identifier, or 404 when it does not exist.")
+            .Produces<TodoItem>(StatusCodes.Status200OK)
+            .Produces(StatusCodes.Status404NotFound);
+
+        group.MapPost("", CreateTodoAsync)
+            .WithName("CreateTodoItem")
+            .WithSummary("Create a todo item")
+            .WithDescription("Validates the request and creates a todo item with a server-assigned identifier.")
+            .Accepts<TodoRequest>("application/json")
+            .Produces<TodoItem>(StatusCodes.Status201Created)
+            .ProducesValidationProblem();
+
+        group.MapPut("/{id:int}", UpdateTodoAsync)
+            .WithName("UpdateTodoItem")
+            .WithSummary("Update a todo item")
+            .WithDescription("Replaces the editable values of an existing todo item.")
+            .Accepts<TodoRequest>("application/json")
+            .Produces<TodoItem>(StatusCodes.Status200OK)
+            .ProducesValidationProblem()
+            .Produces(StatusCodes.Status404NotFound);
+
+        group.MapDelete("/{id:int}", DeleteTodoAsync)
+            .WithName("DeleteTodoItem")
+            .WithSummary("Delete a todo item")
+            .WithDescription("Deletes an existing todo item and returns 404 when the identifier is unknown.")
+            .Produces(StatusCodes.Status204NoContent)
+            .Produces(StatusCodes.Status404NotFound);
+
+        return endpoints;
+    }
+
+    private static async Task<IResult> GetTodosAsync(TodoDbContext dbContext)
+    {
+        var items = await dbContext.TodoItems
+            .AsNoTracking()
+            .OrderBy(item => item.Id)
+            .ToListAsync();
+
+        return TypedResults.Ok(items);
+    }
+
+    private static async Task<IResult> GetTodoByIdAsync(int id, TodoDbContext dbContext)
+    {
+        var item = await dbContext.TodoItems.AsNoTracking()
+            .SingleOrDefaultAsync(item => item.Id == id);
+
+        return item is null ? TypedResults.NotFound() : TypedResults.Ok(item);
+    }
+
+    private static async Task<IResult> CreateTodoAsync(TodoRequest request, TodoDbContext dbContext)
+    {
+        var errors = Validate(request);
+        if (errors.Count > 0)
+        {
+            return TypedResults.ValidationProblem(errors);
+        }
+
+        var item = new TodoItem
+        {
+            Title = request.Title.Trim(),
+            IsComplete = request.IsComplete
+        };
+
+        dbContext.TodoItems.Add(item);
+        await dbContext.SaveChangesAsync();
+
+        return TypedResults.Created($"/api/todos/{item.Id}", item);
+    }
+
+    private static async Task<IResult> UpdateTodoAsync(
+        int id,
+        TodoRequest request,
+        TodoDbContext dbContext)
+    {
+        var item = await dbContext.TodoItems.FindAsync(id);
+        if (item is null)
+        {
+            return TypedResults.NotFound();
+        }
+
+        var errors = Validate(request);
+        if (errors.Count > 0)
+        {
+            return TypedResults.ValidationProblem(errors);
+        }
+
+        item.Title = request.Title.Trim();
+        item.IsComplete = request.IsComplete;
+        await dbContext.SaveChangesAsync();
+
+        return TypedResults.Ok(item);
+    }
+
+    private static async Task<IResult> DeleteTodoAsync(int id, TodoDbContext dbContext)
+    {
+        var item = await dbContext.TodoItems.FindAsync(id);
+        if (item is null)
+        {
+            return TypedResults.NotFound();
+        }
+
+        dbContext.TodoItems.Remove(item);
+        await dbContext.SaveChangesAsync();
+
+        return TypedResults.NoContent();
+    }
+
+    private static Dictionary<string, string[]> Validate(TodoRequest request)
+    {
+        var errors = new Dictionary<string, string[]>(StringComparer.Ordinal);
+        if (string.IsNullOrWhiteSpace(request.Title))
+        {
+            errors[nameof(request.Title)] = ["Title is required."];
+        }
+        else if (request.Title.Trim().Length > 200)
+        {
+            errors[nameof(request.Title)] = ["Title must be 200 characters or fewer."];
+        }
+
+        return errors;
+    }
+
+    public sealed record TodoRequest(string Title, bool IsComplete);
+}
