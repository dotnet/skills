+@model IEnumerable<Book>
+@{
+    ViewData["Title"] = "Books";
+}
+<div class="d-flex justify-content-between align-items-center mb-3">
+    <h1>Books</h1>
+    <a asp-action="Create" class="btn btn-primary">Add book</a>
+</div>
+<table class="table table-striped align-middle">
+    <thead>
+        <tr>
+            <th>@Html.DisplayNameFor(model => model.Title)</th>
+            <th>@Html.DisplayNameFor(model => model.PublicationYear)</th>
+            <th>Author</th>
+            <th></th>
+        </tr>
+    </thead>
+    <tbody>
+@foreach (var item in Model)
+{
+        <tr>
+            <td>@Html.DisplayFor(_ => item.Title)</td>
+            <td>@Html.DisplayFor(_ => item.PublicationYear)</td>
+            <td>@Html.DisplayFor(_ => item.Author.Name)</td>
+            <td class="text-end">
+                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
+                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
+                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
+            </td>
+        </tr>
+}
+    </tbody>
+</table>
