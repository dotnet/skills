+@ParentChildApi_HostAddress = http://localhost:5083
+
+### Create a category before creating a product
+# @name createCategory
+POST {{ParentChildApi_HostAddress}}/api/categories
+Content-Type: application/json
+
+{
+  "name": "Hardware"
+}
+
+### List categories
+GET {{ParentChildApi_HostAddress}}/api/categories
+Accept: application/json
+
+### Get the created category
+GET {{ParentChildApi_HostAddress}}/api/categories/{{createCategory.response.body.$.id}}
+Accept: application/json
+
+### Update the created category
+PUT {{ParentChildApi_HostAddress}}/api/categories/{{createCategory.response.body.$.id}}
+Content-Type: application/json
+
+{
+  "name": "Computer hardware"
+}
+
+### Create a product with the returned category id
+# @name createProduct
+POST {{ParentChildApi_HostAddress}}/api/products
+Content-Type: application/json
+
+{
+  "name": "Mechanical keyboard",
+  "price": 89.99,
+  "categoryId": {{createCategory.response.body.$.id}}
+}
+
+### List products
+GET {{ParentChildApi_HostAddress}}/api/products
+Accept: application/json
+
+### Get the created product
+GET {{ParentChildApi_HostAddress}}/api/products/{{createProduct.response.body.$.id}}
+Accept: application/json
+
+### Update the created product
+PUT {{ParentChildApi_HostAddress}}/api/products/{{createProduct.response.body.$.id}}
+Content-Type: application/json
+
+{
+  "name": "Mechanical keyboard",
+  "price": 79.99,
+  "categoryId": {{createCategory.response.body.$.id}}
+}
+
+### Delete the created product
+DELETE {{ParentChildApi_HostAddress}}/api/products/{{createProduct.response.body.$.id}}
+
+### Delete the now-empty category
+DELETE {{ParentChildApi_HostAddress}}/api/categories/{{createCategory.response.body.$.id}}
