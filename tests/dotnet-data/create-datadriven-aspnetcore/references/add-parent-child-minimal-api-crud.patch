+++ b/fixtures/minimal-api-parent-fk/Endpoints/ProductEndpoints.cs
@@ -0,0 +1,322 @@
+using Microsoft.EntityFrameworkCore;
+using ParentChildApi.Data;
+using ParentChildApi.Models;
+
+namespace ParentChildApi.Endpoints;
+
+public static class ProductEndpoints
+{
+    public static IEndpointRouteBuilder MapProductEndpoints(this IEndpointRouteBuilder endpoints)
+    {
+        var categories = endpoints.MapGroup("/api/categories").WithTags("Categories");
+        categories.MapGet("", GetCategoriesAsync)
+            .WithName("GetCategories")
+            .WithSummary("List categories")
+            .WithDescription("Returns all categories ordered by name.")
+            .Produces<List<CategoryResponse>>(StatusCodes.Status200OK);
+        categories.MapGet("/{id:int}", GetCategoryByIdAsync)
+            .WithName("GetCategoryById")
+            .WithSummary("Get one category")
+            .WithDescription("Returns the requested category, or 404 when it does not exist.")
+            .Produces<CategoryResponse>(StatusCodes.Status200OK)
+            .Produces(StatusCodes.Status404NotFound);
+        categories.MapPost("", CreateCategoryAsync)
+            .WithName("CreateCategory")
+            .WithSummary("Create a category")
+            .WithDescription("Validates and creates a category with a server-assigned identifier.")
+            .Accepts<CategoryRequest>("application/json")
+            .Produces<CategoryResponse>(StatusCodes.Status201Created)
+            .ProducesValidationProblem();
+        categories.MapPut("/{id:int}", UpdateCategoryAsync)
+            .WithName("UpdateCategory")
+            .WithSummary("Update a category")
+            .WithDescription("Changes the name of an existing category.")
+            .Accepts<CategoryRequest>("application/json")
+            .Produces<CategoryResponse>(StatusCodes.Status200OK)
+            .ProducesValidationProblem()
+            .Produces(StatusCodes.Status404NotFound);
+        categories.MapDelete("/{id:int}", DeleteCategoryAsync)
+            .WithName("DeleteCategory")
+            .WithSummary("Delete a category")
+            .WithDescription("Deletes an empty category; categories with products return 409.")
+            .Produces(StatusCodes.Status204NoContent)
+            .Produces(StatusCodes.Status404NotFound)
+            .Produces(StatusCodes.Status409Conflict);
+
+        var products = endpoints.MapGroup("/api/products").WithTags("Products");
+        products.MapGet("", GetProductsAsync)
+            .WithName("GetProducts")
+            .WithSummary("List products")
+            .WithDescription("Returns all products with their category names.")
+            .Produces<List<ProductResponse>>(StatusCodes.Status200OK);
+        products.MapGet("/{id:int}", GetProductByIdAsync)
+            .WithName("GetProductById")
+            .WithSummary("Get one product")
+            .WithDescription("Returns the requested product and its category, or 404 when absent.")
+            .Produces<ProductResponse>(StatusCodes.Status200OK)
+            .Produces(StatusCodes.Status404NotFound);
+        products.MapPost("", CreateProductAsync)
+            .WithName("CreateProduct")
+            .WithSummary("Create a product")
+            .WithDescription("Validates the product and its required category before creation.")
+            .Accepts<ProductRequest>("application/json")
+            .Produces<ProductResponse>(StatusCodes.Status201Created)
+            .ProducesValidationProblem();
+        products.MapPut("/{id:int}", UpdateProductAsync)
+            .WithName("UpdateProduct")
+            .WithSummary("Update a product")
+            .WithDescription("Updates an existing product after validating its required category.")
+            .Accepts<ProductRequest>("application/json")
+            .Produces<ProductResponse>(StatusCodes.Status200OK)
+            .ProducesValidationProblem()
+            .Produces(StatusCodes.Status404NotFound);
+        products.MapDelete("/{id:int}", DeleteProductAsync)
+            .WithName("DeleteProduct")
+            .WithSummary("Delete a product")
+            .WithDescription("Deletes an existing product, or returns 404 for an unknown identifier.")
+            .Produces(StatusCodes.Status204NoContent)
+            .Produces(StatusCodes.Status404NotFound);
+
+        return endpoints;
+    }
+
+    private static async Task<IResult> GetCategoriesAsync(StoreDbContext dbContext)
+    {
+        var categories = await dbContext.Categories.AsNoTracking()
+            .OrderBy(category => category.Name)
+            .Select(category => new CategoryResponse(category.Id, category.Name))
+            .ToListAsync();
+
+        return TypedResults.Ok(categories);
+    }
+
+    private static async Task<IResult> GetCategoryByIdAsync(int id, StoreDbContext dbContext)
+    {
+        var category = await dbContext.Categories.AsNoTracking()
+            .Where(category => category.Id == id)
+            .Select(category => new CategoryResponse(category.Id, category.Name))
+            .SingleOrDefaultAsync();
+
+        return category is null ? TypedResults.NotFound() : TypedResults.Ok(category);
+    }
+
+    private static async Task<IResult> CreateCategoryAsync(
+        CategoryRequest request,
+        StoreDbContext dbContext)
+    {
+        var errors = Validate(request);
+        if (errors.Count > 0)
+        {
+            return TypedResults.ValidationProblem(errors);
+        }
+
+        var category = new Category { Name = request.Name.Trim() };
+        dbContext.Categories.Add(category);
+        await dbContext.SaveChangesAsync();
+
+        var response = new CategoryResponse(category.Id, category.Name);
+        return TypedResults.Created($"/api/categories/{category.Id}", response);
+    }
+
+    private static async Task<IResult> UpdateCategoryAsync(
+        int id,
+        CategoryRequest request,
+        StoreDbContext dbContext)
+    {
+        var category = await dbContext.Categories.FindAsync(id);
+        if (category is null)
+        {
+            return TypedResults.NotFound();
+        }
+
+        var errors = Validate(request);
+        if (errors.Count > 0)
+        {
+            return TypedResults.ValidationProblem(errors);
+        }
+
+        category.Name = request.Name.Trim();
+        await dbContext.SaveChangesAsync();
+
+        return TypedResults.Ok(new CategoryResponse(category.Id, category.Name));
+    }
+
+    private static async Task<IResult> DeleteCategoryAsync(int id, StoreDbContext dbContext)
+    {
+        var category = await dbContext.Categories.FindAsync(id);
+        if (category is null)
+        {
+            return TypedResults.NotFound();
+        }
+
+        if (await dbContext.Products.AnyAsync(product => product.CategoryId == id))
+        {
+            return TypedResults.Conflict(new
+            {
+                message = "Delete the category's products before deleting the category."
+            });
+        }
+
+        dbContext.Categories.Remove(category);
+        await dbContext.SaveChangesAsync();
+        return TypedResults.NoContent();
+    }
+
+    private static async Task<IResult> GetProductsAsync(StoreDbContext dbContext)
+    {
+        var products = await dbContext.Products.AsNoTracking()
+            .OrderBy(product => product.Name)
+            .Select(product => new ProductResponse(
+                product.Id,
+                product.Name,
+                product.Price,
+                product.CategoryId,
+                product.Category.Name))
+            .ToListAsync();
+
+        return TypedResults.Ok(products);
+    }
+
+    private static async Task<IResult> GetProductByIdAsync(int id, StoreDbContext dbContext)
+    {
+        var product = await dbContext.Products.AsNoTracking()
+            .Where(product => product.Id == id)
+            .Select(product => new ProductResponse(
+                product.Id,
+                product.Name,
+                product.Price,
+                product.CategoryId,
+                product.Category.Name))
+            .SingleOrDefaultAsync();
+
+        return product is null ? TypedResults.NotFound() : TypedResults.Ok(product);
+    }
+
+    private static async Task<IResult> CreateProductAsync(
+        ProductRequest request,
+        StoreDbContext dbContext)
+    {
+        var errors = Validate(request);
+        var category = await dbContext.Categories.FindAsync(request.CategoryId);
+        if (category is null)
+        {
+            errors[nameof(request.CategoryId)] = ["CategoryId must identify an existing category."];
+        }
+
+        if (errors.Count > 0)
+        {
+            return TypedResults.ValidationProblem(errors);
+        }
+
+        var product = new Product
+        {
+            Name = request.Name.Trim(),
+            Price = request.Price,
+            CategoryId = request.CategoryId
+        };
+        dbContext.Products.Add(product);
+        await dbContext.SaveChangesAsync();
+
+        var response = new ProductResponse(
+            product.Id,
+            product.Name,
+            product.Price,
+            product.CategoryId,
+            category!.Name);
+        return TypedResults.Created($"/api/products/{product.Id}", response);
+    }
+
+    private static async Task<IResult> UpdateProductAsync(
+        int id,
+        ProductRequest request,
+        StoreDbContext dbContext)
+    {
+        var product = await dbContext.Products.FindAsync(id);
+        if (product is null)
+        {
+            return TypedResults.NotFound();
+        }
+
+        var errors = Validate(request);
+        var category = await dbContext.Categories.FindAsync(request.CategoryId);
+        if (category is null)
+        {
+            errors[nameof(request.CategoryId)] = ["CategoryId must identify an existing category."];
+        }
+
+        if (errors.Count > 0)
+        {
+            return TypedResults.ValidationProblem(errors);
+        }
+
+        product.Name = request.Name.Trim();
+        product.Price = request.Price;
+        product.CategoryId = request.CategoryId;
+        await dbContext.SaveChangesAsync();
+
+        return TypedResults.Ok(new ProductResponse(
+            product.Id,
+            product.Name,
+            product.Price,
+            product.CategoryId,
+            category!.Name));
+    }
+
+    private static async Task<IResult> DeleteProductAsync(int id, StoreDbContext dbContext)
+    {
+        var product = await dbContext.Products.FindAsync(id);
+        if (product is null)
+        {
+            return TypedResults.NotFound();
+        }
+
+        dbContext.Products.Remove(product);
+        await dbContext.SaveChangesAsync();
+        return TypedResults.NoContent();
+    }
+
+    private static Dictionary<string, string[]> Validate(CategoryRequest request)
+    {
+        var errors = new Dictionary<string, string[]>(StringComparer.Ordinal);
+        if (string.IsNullOrWhiteSpace(request.Name))
+        {
+            errors[nameof(request.Name)] = ["Name is required."];
+        }
+        else if (request.Name.Trim().Length > 100)
+        {
+            errors[nameof(request.Name)] = ["Name must be 100 characters or fewer."];
+        }
+
+        return errors;
+    }
+
+    private static Dictionary<string, string[]> Validate(ProductRequest request)
+    {
+        var errors = new Dictionary<string, string[]>(StringComparer.Ordinal);
+        if (string.IsNullOrWhiteSpace(request.Name))
+        {
+            errors[nameof(request.Name)] = ["Name is required."];
+        }
+        else if (request.Name.Trim().Length > 200)
+        {
+            errors[nameof(request.Name)] = ["Name must be 200 characters or fewer."];
+        }
+
+        if (request.Price is < 0.01m or > 10000m)
+        {
+            errors[nameof(request.Price)] = ["Price must be between 0.01 and 10000."];
+        }
+
+        return errors;
+    }
+
+    public sealed record CategoryRequest(string Name);
+    public sealed record CategoryResponse(int Id, string Name);
+    public sealed record ProductRequest(string Name, decimal Price, int CategoryId);
+    public sealed record ProductResponse(
+        int Id,
+        string Name,
+        decimal Price,
+        int CategoryId,
+        string CategoryName);
+}
