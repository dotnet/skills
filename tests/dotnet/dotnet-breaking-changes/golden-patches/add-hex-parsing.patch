diff --git a/src/Billing/AppSettingsHelper.cs b/src/Billing/AppSettingsHelper.cs
index f8923ed..733ac75 100644
--- a/src/Billing/AppSettingsHelper.cs
+++ b/src/Billing/AppSettingsHelper.cs
@@ -1,3 +1,5 @@
+using System.Globalization;
+
 namespace Billing;
 
 /// <summary>Parses application settings, returning a fallback when the raw value is missing or invalid.</summary>
@@ -6,6 +8,19 @@ public static class AppSettingsHelper
     public static int ParseIntSetting(string? raw, int fallback)
         => int.TryParse(raw, out var v) ? v : fallback;
 
+    public static int ParseIntSetting(string? raw, int fallback, bool allowHex)
+    {
+        if (allowHex &&
+            raw is not null &&
+            raw.StartsWith("0x", StringComparison.OrdinalIgnoreCase) &&
+            int.TryParse(raw.AsSpan(2), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out var hex))
+        {
+            return hex;
+        }
+
+        return ParseIntSetting(raw, fallback);
+    }
+
     public static bool ParseBoolSetting(string? raw, bool fallback)
         => bool.TryParse(raw, out var v) ? v : fallback;
 }
