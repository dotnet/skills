 /// <summary>Reads configuration values, returning a fallback when the raw value is missing or invalid.</summary>
+/// <remarks>
+/// Shipped public API (see PublicAPI.Shipped.txt), so it is kept as a forwarder for existing
+/// consumers rather than removed. New code should call <see cref="AppSettingsHelper"/>.
+/// </remarks>
+[Obsolete("Use AppSettingsHelper.ParseIntSetting and AppSettingsHelper.ParseBoolSetting instead.")]
 public static class ConfigReader
 {
     public static int ReadInt(string? raw, int fallback)
-        => int.TryParse(raw, out var v) ? v : fallback;
+        => AppSettingsHelper.ParseIntSetting(raw, fallback);
 
     public static bool ReadBool(string? raw, bool fallback)
-        => bool.TryParse(raw, out var v) ? v : fallback;
+        => AppSettingsHelper.ParseBoolSetting(raw, fallback);
 }
